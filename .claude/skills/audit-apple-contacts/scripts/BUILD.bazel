load("@rules_python//python:defs.bzl", "py_library", "py_test")

# These scripts run from a laptop against a personal address book, not from any
# image. They are tested because a matching rule that is subtly wrong looks
# exactly like one that is right: a shared household landline reads as a
# duplicate, and merging on it silently destroys a contact.
# The scripts are a library the tests depend on, not sources of the test
# itself: Bazel does not instrument a test target's own files.
py_library(
    name = "audit_apple_contacts_lib",
    srcs = glob(["*.py"]),
)

py_test(
    name = "audit_apple_contacts_tests",
    timeout = "short",
    main = "tests/main.py",
    srcs = glob(["tests/*.py"]),
    deps = [
        ":audit_apple_contacts_lib",
        "@pypi//pytest",
    ],
)
