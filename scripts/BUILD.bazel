load("@rules_python//python:defs.bzl", "py_test")
load("@pypi//:requirements.bzl", "requirement")

# `affected_tests.py` decides which suites CI runs. Untested, a bug in it
# reports "nothing to test" and the PR goes green having verified less than
# it appears to.
py_test(
    name = "scripts_tests",
    timeout = "short",
    srcs = glob(["tests/**/*.py"]) + ["affected_tests.py"],
    main = "tests/main.py",
    deps = [requirement("pytest")],
)
