load("//tools/bazel:python_service.bzl", "image", "python_service", "service")

python_service(
    name = "bot",
    package = "chucknorris_bot",
    repository = "europe-southwest1-docker.pkg.dev/biwenger-tools/biwenger-docker/chucknorris_bot",
    service = service(
        main = "app.py",
        secrets = [".env"],
        deps = ["@pypi//requests"],
    ),
    image = image(
        env = {
            "PORT": "8080",
            "PYTHONPATH": "/app",
        },
    ),
)
