# scraper_job/BUILD.bazel
load("//tools/bazel:python_service.bzl", "image", "job", "python_job")

# A Cloud Run **Job**, not a service: it scrapes the league board and exits.
# `python_job` generates the same targets as `python_service` minus `PORT` —
# see tools/bazel/python_service.bzl.
python_job(
    name = "scraper_job",
    package = "biwenger_tools",
    repository = "europe-southwest1-docker.pkg.dev/biwenger-tools/biwenger-docker/scraper_job",
    job = job(
        main = "main.py",
        secrets = [".env"],
        deps = [
            "@pypi//unidecode",
            "@pypi//beautifulsoup4",
            "@pypi//python_dotenv",
        ],
        test_deps = [
            "//core",
            "@pypi//requests_mock",
            "@pypi//freezegun",
        ],
    ),
    image = image(
        env = {"PYTHONPATH": "/app"},
    ),
)
