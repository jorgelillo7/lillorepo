load("//tools/bazel:python_service.bzl", "image", "python_service", "service")

python_service(
    name = "api",
    package = "biwenger_tools",
    repository = "europe-southwest1-docker.pkg.dev/biwenger-tools/biwenger-docker/api",
    service = service(
        main = "app.py",
        package_srcs = ["//packages/biwenger_tools:constants.py"],
        secrets = [".env"],
        deps = [
            "@pypi//matplotlib",
            "@pypi//requests",
            "@pypi//unidecode",
            "//packages/biwenger_tools:constants",
        ],
    ),
    image = image(
        env = {
            "PORT": "8080",
            "PYTHONPATH": "/app",
        },
    ),
)
