load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@pypi//:requirements.bzl", "requirement")

# Interactive photo audit (local, uses ADC). Read-only by default; --fix
# mutates GCS + Firestore behind confirmations. Reuses the web library so it
# shares the exact photo/studio/repository logic the service runs.
py_binary(
    name = "audit_photos",
    srcs = ["audit_photos.py"],
    main = "audit_photos.py",
    deps = ["//packages/be_water/web:web_lib"],
)

# One-shot backfill of Water.sources (field provenance). Dry-run by default.
py_binary(
    name = "backfill_sources",
    srcs = ["backfill_sources.py"],
    main = "backfill_sources.py",
    deps = ["//packages/be_water/web:web_lib"],
)

# One-shot backfill: each dated water's current composition becomes the first
# entry of its analysis series, so the ficha's selector is not empty on day one.
py_binary(
    name = "backfill_analyses",
    srcs = ["backfill_analyses.py"],
    main = "backfill_analyses.py",
    deps = ["//packages/be_water/web:web_lib"],
)

# One-shot backfill of Water.community from the province. Dry-run by default.
py_binary(
    name = "backfill_communities",
    srcs = ["backfill_communities.py"],
    main = "backfill_communities.py",
    deps = ["//packages/be_water/web:web_lib"],
)

# Interactive data curation (local, uses ADC): verification sign-off now,
# duplicate/anomaly review later. Reuses the web curation engine.
py_binary(
    name = "audit_data",
    srcs = ["audit_data.py"],
    main = "audit_data.py",
    deps = ["//packages/be_water/web:web_lib"],
)

# Undo a contribution that overwrote a composition, from the revision trail
# the add flow writes. Local, uses ADC; every write behind a confirmation.
py_binary(
    name = "revert_water",
    srcs = ["revert_water.py"],
    main = "revert_water.py",
    deps = ["//packages/be_water/web:web_lib"],
)

# One-shot backfill of Water.analysis_date by re-reading the stored label
# photos through the OCR. Dry-run by default.
py_binary(
    name = "backfill_analysis_date",
    srcs = ["backfill_analysis_date.py"],
    main = "backfill_analysis_date.py",
    deps = ["//packages/be_water/web:web_lib"],
)

# The recognised-waters parser. Not a py_binary: it needs a local-only pypdf
# and runs by hand. Only the column and cell-wrapping rules are tested — they
# are where every regression this script has had actually lived.
py_test(
    name = "scripts_tests",
    timeout = "short",
    srcs = glob(["tests/**/*.py"]) + ["refresh_aesan_snapshot.py"],
    main = "tests/main.py",
    deps = [requirement("pytest")],
)
