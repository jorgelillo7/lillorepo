load("@rules_python//python:defs.bzl", "py_binary")

# Interactive photo audit (local, uses ADC). Read-only by default; --fix
# mutates GCS + Firestore behind confirmations. Reuses the web library so it
# shares the exact photo/studio/repository logic the service runs.
py_binary(
    name = "audit_photos",
    srcs = ["audit_photos.py"],
    main = "audit_photos.py",
    deps = ["//packages/be_water/web:web_lib"],
)

# One-shot backfill of Water.sources (field provenance). Dry-run by default.
py_binary(
    name = "backfill_sources",
    srcs = ["backfill_sources.py"],
    main = "backfill_sources.py",
    deps = ["//packages/be_water/web:web_lib"],
)

# One-shot backfill of Water.community from the province. Dry-run by default.
py_binary(
    name = "backfill_communities",
    srcs = ["backfill_communities.py"],
    main = "backfill_communities.py",
    deps = ["//packages/be_water/web:web_lib"],
)

# Interactive data curation (local, uses ADC): verification sign-off now,
# duplicate/anomaly review later. Reuses the web curation engine.
py_binary(
    name = "audit_data",
    srcs = ["audit_data.py"],
    main = "audit_data.py",
    deps = ["//packages/be_water/web:web_lib"],
)
