# --- MÓDULO PRINCIPAL ---
module(
    name = "biwenger-tools",
    version = "1.0",
)

# Dependencias de reglas de Bazel
bazel_dep(name = "rules_python", version = "2.3.4")
bazel_dep(name = "rules_oci", version = "2.3.0")

# Already resolved through rules_oci; declared to load platform_transition_filegroup.
bazel_dep(name = "aspect_bazel_lib", version = "2.21.1")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "platforms", version = "1.1.0")

# --- TOOLCHAINS Y DEPENDENCIAS DE PYTHON ---
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    # Enables `bazel coverage` line instrumentation using the coverage tool
    # bundled with rules_python (CPython 3.9–3.14). Added to py_test deps only
    # during coverage runs — never ships in the runtime image.
    configure_coverage_tool = True,
    python_version = "3.14",
)
use_repo(python, python_toolchain = "python_3_14")

# Se utiliza la extensión pip para gestionar las dependencias de Python
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.14",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "pypi")

# --- IMÁGENES BASE DE DOCKER ---
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# Imagen base CON TODAS las dependencias preinstaladas (para producción)
oci.pull(
    name = "python_with_deps",
    digest = "sha256:7f6ac49683781b341c3cfcd4aaed3099314e0531601e2517e5743f97cc761469",
    image = "europe-southwest1-docker.pkg.dev/biwenger-tools/biwenger-docker/python-base",
    platforms = [
        "linux/amd64",
    ],
)
use_repo(oci, "python_with_deps", "python_with_deps_linux_amd64")
