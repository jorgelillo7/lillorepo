# --- MÓDULO PRINCIPAL ---
module(
    name = "biwenger-tools",
    version = "1.0",
)

# Dependencias de reglas de Bazel
bazel_dep(name = "rules_python", version = "2.4.6")
bazel_dep(name = "rules_oci", version = "2.3.0")

# Already resolved through rules_oci; declared to load platform_transition_filegroup.
bazel_dep(name = "aspect_bazel_lib", version = "2.21.1")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "platforms", version = "1.1.0")

# --- TOOLCHAINS Y DEPENDENCIAS DE PYTHON ---
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    # Enables `bazel coverage` line instrumentation using the coverage tool
    # bundled with rules_python (CPython 3.9–3.14). Added to py_test deps only
    # during coverage runs — never ships in the runtime image.
    configure_coverage_tool = True,
    python_version = "3.14",
)
use_repo(python, python_toolchain = "python_3_14")

# Se utiliza la extensión pip para gestionar las dependencias de Python
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.14",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "pypi")

# --- IMÁGENES BASE DE DOCKER ---
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# Imagen base CON TODAS las dependencias preinstaladas (para producción)
oci.pull(
    name = "python_with_deps",
    digest = "sha256:76ac1a8a27e66e0abd746cfe29a325ebdb691bd6620906720f1c959e71f8f370",
    image = "europe-southwest1-docker.pkg.dev/biwenger-tools/biwenger-docker/python-base",
    platforms = [
        "linux/amd64",
    ],
)
use_repo(oci, "python_with_deps", "python_with_deps_linux_amd64")

# --- TAILWIND (standalone CLI, no npm) ---
# Pinned to the release the Play CDN served, so compiled CSS matches what the
# pages rendered before. SHA-256 values come from the release's sha256sums.txt.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "tailwindcss_macos_arm64",
    executable = True,
    sha256 = "a1d0c7985759accca0bf12e51ac1dcbf0f6cf2fffb62e6e0f62d091c477a10a3",
    url = "https://github.com/tailwindlabs/tailwindcss/releases/download/v3.4.17/tailwindcss-macos-arm64",
)

http_file(
    name = "tailwindcss_linux_x64",
    executable = True,
    sha256 = "7d24f7fa191d2193b78cd5f5a42a6093e14409521908529f42d80b11fde1f1d4",
    url = "https://github.com/tailwindlabs/tailwindcss/releases/download/v3.4.17/tailwindcss-linux-x64",
)
