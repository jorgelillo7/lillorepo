# Archivo de entorno - Contiene credenciales sensibles
.env

# Archivos de credenciales de Google OAuth 2.0 - No subir nunca
biwenger-tools-sa.json

# Entorno virtual de Python
venv/
__pycache__/
*.pyc
venv-*/

# Archivos del sistema operativo (macOS, Windows)
.DS_Store
Thumbs.db

#csv exportación
*.csv

# Local work-list from the be_water photo audit script (scripts/audit_photos.py)
photo_audit.json

.vscode/*
# Metadatos del paquete
*.egg-info/

#bazel
bazel-*
# Session-scoped Claude plans (see CLAUDE.md → ## Plans)
.claude/plans/
# Machine audit reports: an inventory of installed software and its versions
# is reconnaissance, and this repo is public. Owner's eyes only.
.claude/skills/audit-mac-tools/reports/
# Draft skill Phase-B output — the skill's own .gitignore only covers its
# directory, but the generator writes to the repo root by default.
mi-*.md
draft-ranked*.csv

# Claude Code per-machine permission allow-list. Local by nature, and it
# accumulates whole command lines — which is how an API key ends up in it.
.claude/settings.local.json

# Agent worktrees — transient checkouts, never part of a commit.
.claude/worktrees/

# Address-book audit output: real contact data, and this repository is public.
# The skill's --out should point outside the tree; this is the second line of
# defence for anything that lands inside it anyway.
.claude/skills/audit-apple-contacts/reports/
.claude/skills/audit-apple-contacts/**/*.vcf
.claude/skills/audit-apple-contacts/**/records.json
.claude/skills/audit-apple-contacts/**/actions.json
.claude/skills/audit-apple-contacts/**/decisions.json
.claude/skills/audit-apple-contacts/scripts/config.json

# Personal working notes, kept out of a public repository. The pattern is
# `NOTES.local.md` anywhere, so any package can keep a private notebook beside
# its public docs without a new rule each time.
NOTES.local.md
**/NOTES.local.md

# Emulation working material. The repository is public and this is where dumps
# live before they reach the card — the directories are tracked by their
# .gitkeep and nothing else. `sdcard.sh` re-checks the index at runtime rather
# than trusting these lines: a rule written on a feature branch is not in
# effect on the branch you happen to be committing from, which is exactly how
# a private file reached master on 2026-08-25.
packages/emulation_thor6/BIOS/*
packages/emulation_thor6/ROMs/*
!packages/emulation_thor6/BIOS/.gitkeep
!packages/emulation_thor6/ROMs/.gitkeep
