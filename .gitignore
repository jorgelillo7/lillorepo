# Archivo de entorno - Contiene credenciales sensibles
.env

# Archivos de credenciales de Google OAuth 2.0 - No subir nunca
biwenger-tools-sa.json

# Entorno virtual de Python
venv/
__pycache__/
*.pyc
venv-*/

# Archivos del sistema operativo (macOS, Windows)
.DS_Store
Thumbs.db

#csv exportación
*.csv

# Local work-list from the be_water photo audit script (scripts/audit_photos.py)
photo_audit.json

.vscode/*
# Metadatos del paquete
*.egg-info/

#bazel
bazel-*
# Session-scoped Claude plans (see CLAUDE.md → ## Plans)
.claude/plans/
# Draft skill Phase-B output — the skill's own .gitignore only covers its
# directory, but the generator writes to the repo root by default.
mi-*.md
draft-ranked*.csv

# Claude Code per-machine permission allow-list. Local by nature, and it
# accumulates whole command lines — which is how an API key ends up in it.
.claude/settings.local.json

# Agent worktrees — transient checkouts, never part of a commit.
.claude/worktrees/
